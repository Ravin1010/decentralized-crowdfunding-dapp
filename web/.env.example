# All VITE_ values are public browser configuration. Never place secrets here.
# Leave blank for labeled demo mode. A verified Sepolia contract exists; see README.md.
# To enable live testing locally, explicitly set its verified address (chain 11155111).
# Never put private keys, tokens, or secret API keys in VITE_ variables.
VITE_CROWDFUND_CONTRACT_ADDRESS=
# Optional public Sepolia HTTPS RPC; default is PublicNode. No secret API keys.
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
